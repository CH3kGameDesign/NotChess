  m_Script: {fileID: 11500000, guid: 9f23c9f0aaa2c6b40a01872e42a35435, type: 3}
  m_Name: Game Modifier List
  m_EditorClassIdentifier: 
  list:
  - id: PermaMultx2
    name: Perma Mult x2
    description: x2 In Game Multiplier
    sprAddressable:
      id: S_Queen
      spr: {fileID: 21300000, guid: e8c9493c28893334fb3d338c27f80d1b, type: 3}
    cost: 4
    weight: 1
    effectID: multiplierMultiply
    effectVar: 2
    effectVar2: N/A
    triggerID: passive
  - id: HalfPriceRerolls
    name: Half Price Rerolls
    description: Rerolls in the store are half priced
    sprAddressable:
      id: S_Knight
      spr: {fileID: 21300000, guid: dbc2dc009204f384f83fb7fcbb6e6e29, type: 3}
    cost: 5
    weight: 1
    effectID: rerollCost
    effectVar: 0.5
    effectVar2: N/A
    triggerID: passive
  - id: DeadManScoring
    name: Dead Man Scoring
    description: Gain +20 Points for every piece of yours that is destroyed
    sprAddressable:
      id: S_Bishop
      spr: {fileID: 21300000, guid: 3991ff03c45db844687159ee45ddb5b3, type: 3}
    cost: 5
    weight: 1
    effectID: pointAdd
    effectVar: 20
    effectVar2: N/A
    triggerID: allyDeath
  - id: Hoarder
    name: Hoarder
    description: Gain +2 Mult for every card held at the end of your turn
    sprAddressable:
      id: S_Rook
      spr: {fileID: 21300000, guid: 580373cf13fd2f4468d894429e945ef9, type: 3}
    cost: 5
    weight: 1
    effectID: multiplierAddPerVar
    effectVar: 2
    effectVar2: heldCards
    triggerID: turnEnd
  - id: Greedy
    name: Greedy
    description: Increase Card Limit By 1
    sprAddressable:
      id: S_King
      spr: {fileID: 21300000, guid: ce9ff1f863678d74381ade2166ecf691, type: 3}
    cost: 8
    weight: 1
    effectID: cardLimitAdd
    effectVar: 1
    effectVar2: N/A
    triggerID: passive
  - id: Overstocked
